# LegalLens Environment Configuration Template
# Copy to .env and configure your values.
# NEVER commit real API keys, project secrets, or credentials to version control.

APP_ENV=development

# Google Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Platform Core Settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us

# Google Cloud Storage (Private Legal Documents Bucket)
GCS_BUCKET=

# Google Cloud Firestore (Document & Session Metadata)
FIRESTORE_DATABASE=(default)

# Google Cloud Document AI Layout Parser (Optional OCR enhancement)
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_PROCESSOR_ID=

# Upload Constraints & Privacy
MAX_UPLOAD_MB=10
DOCUMENT_RETENTION_DAYS=7
